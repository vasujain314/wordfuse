{
  "expo": {
    "name": "Word Fuse",
    "slug": "wordfuse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wordfuse",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vasuapps.wordfuse"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "package": "com.vasuapps.wordfuse",
      "permissions": ["android.permission.VIBRATE"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA",
          "imageWidth": 200
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6c31785e-eacf-4a3f-92d8-1a31f2cbf6fa"
      }
    },
    "owner": "vasu_apps",
    "backgroundColor": "#F4F1EA",
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
