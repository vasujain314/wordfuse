{
  "expo": {
    "name": "Word Fuse",
    "slug": "wordfuse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wordfuse",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vasuapps.wordfuse"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "package": "com.vasuapps.wordfuse",
      "permissions": ["android.permission.VIBRATE", "android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wordfuse.expo.app",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6c31785e-eacf-4a3f-92d8-1a31f2cbf6fa"
      }
    },
    "owner": "vasu_apps",
    "backgroundColor": "#F4F1EA",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "description": "A fast, free word game: type a real word containing the letters before the fuse burns out. Play solo or with up to 8 friends online."
  }
}
